<apex:page controller="ContactRegistrationController" showHeader="true" sidebar="false" docType="html-5.0">
    
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet"/>

    <apex:includeScript value="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular.min.js"/>

    <div ng-app="contactApp" ng-controller="ContactCtrl" class="container vh-100 d-flex justify-content-center align-items-center">
        <div class="col-md-6 bg-info p-4 rounded shadow-sm">
            <h2 class="text-center mb-4">Registration Form</h2>
            <form name="contactForm" ng-submit="submitForm()" novalidate="novalidate">

                <div class="form-group">
                    <label for="firstName">First Name:</label>
                    <input id="firstName" type="text" ng-model="contact.firstName" class="form-control" required="required" />
                </div>

                <div class="form-group">
                    <label for="lastName">Last Name:</label>
                    <input id="lastName" type="text" ng-model="contact.lastName" class="form-control" required="required" />
                </div>

                <div class="form-group">
                    <label for="phone">Phone:</label>
                    <input id="phone" type="text" ng-model="contact.phone" class="form-control" required="required" />
                </div>

                <div class="form-group">
                    <label for="email">Email:</label>
                    <input id="email" type="email" ng-model="contact.email" class="form-control" required="required" />
                </div>

                <button type="submit" class="btn btn-primary btn-block" ng-disabled="contactForm.$invalid">Submit</button>
            </form>

            <div ng-if="message" class="alert alert-info mt-3 text-center" role="alert">
                <strong>{{message}}</strong>
            </div>
        </div>
    </div>

    <script>
        angular.module('contactApp', [])
            .controller('ContactCtrl', ['$scope', function($scope) {
                $scope.contact = {};

                $scope.submitForm = function() {
                    var firstName = $scope.contact.firstName || '';
                    var lastName = $scope.contact.lastName || '';
                    var phone = $scope.contact.phone || '';
                    var email = $scope.contact.email || '';

                    Visualforce.remoting.Manager.invokeAction(
                        '{!$RemoteAction.ContactRegistrationController.createContact}',
                        firstName, lastName, phone, email,
                        function(result, event) {
                            if(event.status) {
                                $scope.$apply(function(){
                                    $scope.message = result;
                                    // Clear form after success
                                    $scope.contact = {};
                                    $scope.contactForm.$setPristine();
                                    $scope.contactForm.$setUntouched();
                                });
                            } else {
                                $scope.$apply(function(){
                                    $scope.message = 'Error occurred during Contact creation.';
                                });
                            }
                        },
                        {escape: true}
                    );
                };
            }]);
    </script>
</apex:page>